{
  "devDependencies": {
    "lua-format": "^1.6.1-b"
  },
  "scripts": {
    "build:dist": "npm run generate:index && node scripts/patch_lua_format.cjs && node scripts/minify_dist.cjs",
    "generate:index": "node scripts/nvim_index.cjs",
    "lint:lua": "lua scripts/run_luacheck.lua .",
    "lint": "npm run lint:lua",
    "test:lua_editor": "lua tests/run.lua",
    "test:headless_nvim": "lua tests/run.lua --backend=headless_nvim",
    "test": "npm run test:lua_editor"
  }
}
